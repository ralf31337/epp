# Optional deployment settings for docker compose. Portal tenant, username and password are NOT
# configured here: enter them in the web app after each start (they are kept in memory only).

# EPP_IMAGE=ghcr.io/ralf31337/epp
# EPP_VERSION=latest
# EPP_PORT=3081
# EPP_TIMEZONE=Europe/Berlin

# Public URL when running behind a reverse proxy (used for links in webhooks, ICS and Markdown).
# Optional: without it the URL is derived from the Forwarded / X-Forwarded-* headers.
# EPP_PUBLIC_URL=https://example.org/epp
